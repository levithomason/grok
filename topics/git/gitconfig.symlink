[user]
    name = Levi Thomason
    email = me@levithomason.com
    signingkey = 4D4B1AF3
[alias]
    co = checkout
    promote = "!$GROK_BIN/git-promote"
    count = "!git shortlog -sn"
    history = "log --pretty=format:'%ad - %an - %s' --date=format:'%Y-%m-%d' --follow"
[color]
    diff = auto
    status = auto
    branch = auto
    ui = true
[core]
    editor = vim
    excludesfile = ~/.gitignore
    untrackedCache = true
    fsmonitor = true
[apply]
    whitespace = nowarn
[mergetool]
    keepBackup = false
[difftool]
    prompt = false
[help]
    autocorrect = 1
[push]
    # See `git help config` (search for push.default)
    # for more information on different options of the below setting.
    #
    # Setting to git 2.0 default to suppress warning message
    default = simple
[diff]
    renames = 0
    renameLimit = 9999
[url "ssh://git@bitbucket.org/"]
    insteadOf = https://bitbucket.org/
# GitHub always over https, so bin/gh can pick the account per repo (see
# topics/github/README.md). Rewrites ssh clone URLs too.
[url "https://github.com/"]
    insteadOf = git@github.com:
    insteadOf = ssh://git@github.com/
[pull]
    rebase = false
    merge = only
[http]
    postBuffer = 524288000
[init]
    defaultBranch = master
[credential]
    azreposCredentialType = oauth
	useHttpPath = true
	helper = /Users/levithomason/local/gcm/git-credential-manager
[credential "azrepos:org/domoreexp"]
	username = lethoma@microsoft.com
	azureAuthority = https://login.microsoftonline.com/72f988bf-86f1-41af-91ab-2d7cd011db47
[credential "https://github.com"]
	helper = 
	helper = !$HOME/.grokfiles/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !$HOME/.grokfiles/bin/gh auth git-credential
[credential "azrepos:org/outlookweb"]
	username = lethoma@microsoft.com
[credential "azrepos:org/1esgitops"]
	azureAuthority = https://login.microsoftonline.com/72f988bf-86f1-41af-91ab-2d7cd011db47
[credential "azrepos:org/office"]
	username = levithomason@microsoft.com
[credential "https://domoreexp.visualstudio.com"]
	helper = 
	helper = "!f() { if test \"$1\" = get; then token=$(az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken --output tsv) || return; printf \"username=AzureCLI\\npassword=%s\\n\" \"$token\"; fi; }; f"
